{
  "scopeName": "source.lingo",
  "name": "LINGO",
  "patterns": [
    { "include": "#comment" },
    { "include": "#strings" },
    { "include": "#section-keywords" },
    { "include": "#functions" },
    { "include": "#constraint-label" },
    { "include": "#numbers" },
    { "include": "#hash-operators" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.exclamation.lingo",
      "begin": "!",
      "end": ";|\\n"
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.lingo", "begin": "'", "end": "'" },
        { "name": "string.quoted.double.lingo", "begin": "\"", "end": "\"" }
      ]
    },
    "section-keywords": {
      "patterns": [
        {
          "name": "keyword.control.section.lingo",
          "match": "\\b(?i:MODEL|SETS|ENDSETS|DATA|ENDDATA|CALC|ENDCALC|PROCEDURE|ENDPROCEDURE|END)\\b"
        },
        {
          "name": "keyword.other.objective.lingo",
          "match": "\\b(?i:MAX|MIN)\\b\\s*(?==)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.lingo",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "constraint-label": {
      "patterns": [
        {
          "name": "entity.name.tag.constraint.lingo",
          "match": "\\[[^\\]\\n]+\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lingo",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b|\\.\\d+\\b"
        }
      ]
    },
    "hash-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lingo",
          "match": "#(?i:LE|GE|EQ|NE|LT|GT|AND|OR|NOT)#"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lingo",
          "match": "<=|>=|\\.\\.|[+\\-*/=<>|&]"
        }
      ]
    }
  }
}
