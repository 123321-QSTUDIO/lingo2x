MODEL:

SETS:
COMPARTIMENTS:cap_poids, cap_volume;
CHARGES:poids, volume, gain;
ARC(COMPARTIMENTS,CHARGES):X;
ENDSETS

DATA:
cap_poids,cap_volume,poids,volume,gain=@OLE('cargo.xlsx');
ENDDATA

!FO;
MAX=@SUM(COMPARTIMENTS(c):@SUM(CHARGES(j):(gain(j)*X(c,j))));

!Contraintes;
!Capacite en poids des compartiments a ne pas dépasser;
@FOR(COMPARTIMENTS(c): @SUM(CHARGES(j):X(c,j))<=cap_poids(c));

!Capacite en volume des compartiments a ne pas dépasser;
@FOR(COMPARTIMENTS(c):@SUM(CHARGES(j):volume(j)*X(c,j))<=cap_volume(c));

!Charge totale disponible;
@FOR(CHARGES(j): @SUM(COMPARTIMENTS(c):X(c,j))<=poids(j));


@FOR(COMPARTIMENTS(c) : @SUM(COMPARTIMENTS(u):cap_poids(u))*@SUM(CHARGES(j):X(c,j))=cap_poids(c)*@SUM(arc(t,j) :X(t,j)));


END