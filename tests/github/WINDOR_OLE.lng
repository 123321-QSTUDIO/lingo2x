MODEL :
SETS:
PRODUITS: gain, x;
USINES: disp;
PRODS_USINES(USINES,PRODUITS): utilisation;
ENDSETS

DATA:

PRODUITS, USINES, gain, disp, utilisation= @OLE('WINDOR_OLE.xlsx');


ENDDATA

MAX = @SUM (PRODUITS(p):
             gain(p)*x(p)
);

@FOR(USINES(u): 
   @SUM(PRODUITS(p):
        utilisation(u,p)*x(p))<=disp(u)
);

END