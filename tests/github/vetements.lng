MODEL:
SETS:
MAGASINS /MTLE, CV, MTLO/:total;
VETEMENTS/A, B, C, D, E/:tot_vetement;
ARC(MAGASINS,VETEMENTS):stock,gain,X;
ENDSETS

!Parametres;
DATA:
stock,gain,total,tot_vetement=@OLE('vetements.xlsx');
ENDDATA

! Fonction objectif;
MAX = @SUM(MAGASINS(m):@SUM(VETEMENTS(v):gain(m,v) * X(m,v)));
               

!CONTRAINTES;
!SAC1=pas plus de 100 vetements par magasin au total;
!METHODE 1: explicite;
!@FOR(MAGASINS(m):@SUM(VETEMENTS(v):X(m,v))<=100);
!METHODE 2:algebrique;
@FOR(MAGASINS(m):@SUM(VETEMENTS(v):X(m,v))<=total(m));


!SAC2=pas plus de 90 vetements de type E au total;
!METHODE 1: explicite;
!@SUM(MAGASINS(m):X(m,5))<=90;
!METHODE 2:algebrique;
@FOR(VETEMENTS(v):@SUM(MAGASINS(m):X(m,v))<=tot_vetement(v));

!SAC 3: Ecriture explicite des contraintes sur l equilibre des quantites de vetements dans chaque magasin;
!METHODE1:explicite;
!contrainte sur le magasin MTLE;
!X(1,1)+X(1,2)>1/3*(X(1,3)+X(1,4)+X(1,5));
!contrainte sur le magasin CV;
!X(2,1)+X(2,2)>3*(X(2,3)+X(2,4)+X(2,5));
!contrainte sur le magasin MTLO;
!X(3,4)+X(3,5)<1/4*(X(3,1)+X(3,2)+X(3,3));
!METHODE 2: Utilisation d'ue formulation générale pour la contrainte sur l'equilibre des quantites de vetements dans chaque magasin;
@FOR(MAGASINS(m):@SUM(VETEMENTS(v):stock(m,v)*X(m,v))>=0);




END


