!ENONCE:

MODEL:

SETS:
CLIENTS /1,2,3/;
PRODUCTION /0,1,2,3,4,5/;
ARC(PRODUCTION,CLIENTS): capacite, revenu, x;
ENDSETS

DATA:
bigM = 1000000; ! grand chiffre;

revenu =
  0,0,0,
  1,1,1,
  2,5,3,
  4,0,5,
  0,0,6,
  0,0,7;

capacite =
  0,0,0,
  0.2,0.4,0.2,
  0.4,0.8,0.4,
  0.6,1.2,0.6,
  0.8,1.2,0.8,
  1,1.2,1; ! occupation >100% si capacite depassee
ENDDATA

! Fonction objectif (profit)
MAX = @SUM(ARC(p,c): revenu(p,c) * x(p,c));

! Capacite totale de production
@SUM(ARC(p,c): capacite(p,c) * x(p,c)) <= 1;

! Une seule quantite produite par client
@FOR(CLIENTS(c): @SUM(PRODUCTION(p): x(p,c)) <= 1);

! Variables binaires
@FOR(ARC(p,c): @BIN(x(p,c)));

END
