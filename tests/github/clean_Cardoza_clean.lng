
MODEL:
SETS:
MACHINES/1,2/:DISPONIBILITE;
PRODUITS/remorcage,stabilisateur/:Gain,X;
ARC(MACHINES,PRODUITS):TEMPS;
ENDSETS

DATA:
Gain=130,150;
DISPONIBILITE=16,15;
TEMPS=3.2,2.4,
 2,3;
ENDDATA

!FO;
MAX=@SUM(PRODUITS(p):Gain(p)*X(p));

@FOR(MACHINES(m):@SUM(PRODUITS(p):TEMPS(m,p)*X(p))<=DISPONIBILITE(m));
!variables entieres;
!@FOR(PRODUITS(X):@GIN(X));
END